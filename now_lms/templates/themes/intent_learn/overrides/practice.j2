{# Intent Solutions practice.

   Three states in one surface: pick a certification, pick one of its domains, or
   drill that domain.

   Practice is its own area of the product, keyed by CERTIFICATION and outside courses
   entirely (Max, 2026-08-09). Course was the wrong key: CCA-F alone carries questions
   for two credentials, so a course-scoped view showed 12 mashed-together domains
   instead of the 5 or 7 belonging to the certification a member is actually sitting.

   A drill is rehearsal, not an exam. Nothing is recorded, feedback is immediate,
   and you can work the same weak domain as many times as you like — which is the
   whole reason it does not create an attempt. The exam surface stays the place
   where a score is earned.
#}
{% set current_theme = current_theme() %} {% set config = config() %}

<!doctype html>
<html lang="{{ current_locale() }}" class="h-100">
    <head>
        {{ current_theme.headertags() }}
        <title>
            {% if selected_domain %}{{ selected_domain.name }}{% elif selected_cert %}{{ selected_cert.name }}{% else %}Practice{% endif %} - Intent Solutions Learn
        </title>
        {{ current_theme.local_style() }}
        {# The exam surfaces leave the site's dark front-door palette deliberately: this
           is the PDF's warm-paper grammar at a contrast a candidate can sit in for two
           hours. Loaded last so it wins over theme.min.css. #}
        <link rel="stylesheet" href="{{ url_for('static', filename='themes/intent_learn/exam.css') }}" />
        <style>
            :root {
                /* Point this page's own tokens at the exam-room paper palette in
                   exam.css. They used to read the site's Bootstrap variables, which
                   on this deployment are the dark front-door values, and because this
                   block is inline it beats the stylesheet no matter what order the
                   links are in. That is why the paper background did not take. */
                --is-accent: var(--ex-ember);
                --is-paper: var(--ex-desk);
                --is-ink: var(--ex-ink);
                --is-strong: var(--ex-ink);
                --is-muted: var(--ex-faint);
                --is-line: var(--ex-rule);
                --is-card: var(--ex-sheet);
                --is-bar: var(--ex-sheet);
                --is-pass: #2f9e6f;
                --is-short: #b4553a;
            }
            body.is-practice {
                background: var(--is-paper);
                color: var(--is-ink);
            }
            .is-practice-bar {
                background: var(--is-bar);
                color: var(--is-strong);
            }
            .is-mono {
                font-family: var(--bs-font-monospace, monospace);
                font-size: 0.8125rem;
                letter-spacing: 0.06em;
                text-transform: uppercase;
            }
            .is-card {
                background: var(--is-card);
                border: 1px solid var(--is-line);
                border-radius: 10px;
            }
            .is-domain-card {
                display: block;
                text-decoration: none;
                color: inherit;
                height: 100%;
            }
            .is-domain-card:hover {
                border-color: var(--is-accent);
            }
            .is-meter {
                height: 6px;
                border-radius: 3px;
                background: var(--is-line);
                overflow: hidden;
            }
            .is-meter span {
                display: block;
                height: 100%;
                background: var(--is-accent);
            }
            .is-meter span.is-pass {
                background: var(--is-pass);
            }
            .is-meter span.is-short {
                background: var(--is-short);
            }
            .is-stem {
                font-size: 1.125rem;
                line-height: 1.65;
                color: var(--is-strong);
            }
            .is-choice {
                display: flex;
                gap: 0.85rem;
                align-items: flex-start;
                width: 100%;
                text-align: left;
                border: 1px solid var(--is-line);
                border-radius: 8px;
                background: var(--is-card);
                color: var(--is-ink);
                padding: 0.85rem 1rem;
                margin-bottom: 0.6rem;
                cursor: pointer;
            }
            .is-choice:hover {
                border-color: var(--is-accent);
            }
            .is-choice .is-key {
                flex: 0 0 auto;
                width: 1.6rem;
                height: 1.6rem;
                border: 1px solid var(--is-line);
                border-radius: 4px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-family: var(--bs-font-monospace, monospace);
                font-size: 0.8125rem;
                color: var(--is-muted);
            }
            .is-choice.is-picked {
                border-color: var(--is-accent);
            }
            .is-choice.is-right {
                border-color: var(--is-pass);
            }
            .is-choice.is-right .is-key {
                background: var(--is-pass);
                border-color: var(--is-pass);
                color: var(--bs-body-bg, #09090b);
            }
            .is-choice.is-wrong {
                border-color: var(--is-short);
            }
            .is-choice.is-wrong .is-key {
                background: var(--is-short);
                border-color: var(--is-short);
                color: var(--bs-body-bg, #09090b);
            }
            .is-feedback {
                border-top: 1px solid var(--is-line);
                margin-top: 1rem;
                padding-top: 1rem;
                white-space: pre-line;
                color: var(--is-muted);
            }
            .is-keys {
                font-family: var(--bs-font-monospace, monospace);
                font-size: 0.75rem;
                color: var(--is-muted);
            }
            .is-keys kbd {
                background: var(--is-card);
                border: 1px solid var(--is-line);
                border-radius: 3px;
                color: var(--is-strong);
                padding: 0 0.35rem;
            }
        </style>
    </head>

    <body class="is-practice">
        {{ current_theme.navbar() }}

        <div class="is-practice-bar">
            <div class="container py-2 d-flex flex-wrap justify-content-between align-items-center gap-2">
                <span class="fw-bold">
                    {% if selected_domain %}{{ selected_domain.name }}
                    {% elif selected_cert %}{{ selected_cert.name }}
                    {% else %}Practice{% endif %}
                </span>
                <span class="is-mono" style="color: var(--is-muted)">
                    {% if selected_domain %}Drill &middot; nothing is recorded
                    {% elif selected_cert %}Choose a domain
                    {% else %}Choose a certification{% endif %}
                </span>
            </div>
        </div>

        <main>
            {{ current_theme.notify() }}

            <div class="ex-sheet">
                <div class="row">
                    <div class="col-12">
                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb small">
                                <li class="breadcrumb-item">
                                    <a class="text-reset text-decoration-none" href="{{ url_for('home.panel') }}">Home</a>
                                </li>
                                {% if selected_cert %}
                                <li class="breadcrumb-item">
                                    <a class="text-reset text-decoration-none" href="{{ url_for('evaluation.practice') }}">Practice</a>
                                </li>
                                {% if selected_domain %}
                                <li class="breadcrumb-item">
                                    <a
                                        class="text-reset text-decoration-none"
                                        href="{{ url_for('evaluation.practice', certification_key=selected_cert.key) }}"
                                        >{{ selected_cert.name }}</a
                                    >
                                </li>
                                <li class="breadcrumb-item active" aria-current="page">{{ selected_domain.name }}</li>
                                {% else %}
                                <li class="breadcrumb-item active" aria-current="page">{{ selected_cert.name }}</li>
                                {% endif %}
                                {% else %}
                                <li class="breadcrumb-item active" aria-current="page">Practice</li>
                                {% endif %}
                            </ol>
                        </nav>

                        {% if not selected_cert %}
                        <p class="ex-eyebrow">Intent Solutions &middot; Practice</p>
                        <h1 class="ex-title">Sit the whole thing, once, with the clock running.</h1>
                        <p class="ex-lede">
                            Each certification draws a fresh paper from its bank, weighted to Anthropic's
                            published domain blueprint, with the clock running and no feedback until you
                            submit. Or work one domain at a time, untimed, with the answer straight after
                            each question. Only the full sitting is recorded.
                        </p>

                        {% if certifications %}
                        <div class="ex-section-head">
                            <span class="ex-label">Choose a certification</span>
                            <span class="ex-label">Form &middot; pool</span>
                        </div>
                        <div class="ex-menu">
                            {% for cert in certifications %}{% set sit = sittings.get(cert.key) %}
                            <a class="ex-menu-card" href="{{ url_for('evaluation.practice', certification_key=cert.key) }}">
                                <div class="ex-menu-head">
                                    <span class="ex-menu-code">{{ cert.key }}</span>
                                    {% if sit and sit.best %}
                                    <span class="ex-menu-best {{ 'is-clear' if sit.cleared else 'is-short' }}">
                                        {{ sit.best }}{% if sit.cleared %} &middot; cleared{% endif %}
                                    </span>
                                    {% endif %}
                                </div>
                                <div class="ex-menu-name">{{ cert.name }}</div>
                                {% if sit %}
                                <div class="ex-menu-facts">
                                    <span><b>{{ sit.length }}</b> items</span>
                                    <span><b>{{ sit.minutes }}</b> min</span>
                                    <span><b>{{ sit.cut }}</b> to pass</span>
                                </div>
                                <div class="ex-menu-foot">
                                    drawn fresh from {{ sit.pool }} &middot; {{ cert.domains | length }} domains
                                    {%- if sit.attempts %} &middot; {{ sit.attempts }} attempt{{ '' if sit.attempts == 1 else 's' }}{% endif %}
                                </div>
                                {% else %}
                                <div class="ex-menu-facts"><span>{{ cert.domains | length }} domains</span><span>{{ cert.total }} items</span></div>
                                <div class="ex-menu-foot">Domain practice only, no full-length sitting yet</div>
                                {% endif %}
                            </a>
                            {% endfor %}
                        </div>
                        {% else %}
                        <div class="ex-callout">
                            <div class="ex-callout-label">Nothing to practise yet</div>
                            <p class="mb-0">No questions carry a certification. Re-run the course seeder to label them.</p>
                        </div>
                        {% endif %}

                        <p class="ex-disclosure">
                            <strong>What this is, exactly.</strong> Practice is organised by certification
                            rather than by course, because one course can carry questions for more than one
                            credential. Every item is original, written against Anthropic's published exam
                            guides; none is reproduced from a real exam. A domain drill records nothing. A
                            full sitting is scored on a synthetic 100-1000 scale of our own, because the real
                            conversion is not published, so treat the number as a study signal rather than a
                            prediction.
                        </p>

                        {% elif not selected_domain %}
                        {% set sit = sittings.get(selected_cert.key) %}
                        <p class="ex-eyebrow">{{ selected_cert.name }}</p>
                        <h1 class="ex-title">Sit the whole thing, once, with the clock running.</h1>
                        <p class="ex-lede">
                            {% if sit %}{{ sit.length }} items drawn to Anthropic&rsquo;s published domain blueprint,
                            {{ sit.minutes }} minutes, and no feedback until you submit. You get a study score on a
                            synthetic {{ 100 }}&ndash;{{ 1000 }} scale measured against a {{ sit.cut }} target, then every item
                            back with the reasoning. The scale is ours, not Anthropic&rsquo;s.
                            {% else %}This certification has no full-length mock yet. Work its domains below; a drill
                            is untimed and records nothing.{% endif %}
                        </p>

                        {% if sit %}
                        <div class="ex-spec">
                            <div class="ex-spec-cell">
                                <div class="ex-label">Items</div>
                                <div class="ex-spec-v">{{ sit.length }}</div>
                                <div class="ex-spec-note">drawn from {{ sit.pool }}</div>
                            </div>
                            <div class="ex-spec-cell">
                                <div class="ex-label">Time</div>
                                <div class="ex-spec-v">{{ sit.minutes }}:00</div>
                                <div class="ex-spec-note">auto-submits at zero</div>
                            </div>
                            <div class="ex-spec-cell">
                                <div class="ex-label">Study target</div>
                                <div class="ex-spec-v">{{ sit.cut }}</div>
                                <div class="ex-spec-note">{{ sit.raw_needed }} of {{ sit.length }} correct</div>
                            </div>
                            <div class="ex-spec-cell">
                                <div class="ex-label">Best so far</div>
                                <div class="ex-spec-v {{ 'is-clear' if sit.cleared else ('is-short' if sit.best else '') }}">
                                    {% if sit.best %}{{ sit.best }}{% else %}&mdash;{% endif %}
                                </div>
                                <div class="ex-spec-note">
                                    {% if sit.attempts %}{{ sit.attempts }} attempt{{ '' if sit.attempts == 1 else 's' }}
                                    &middot; {% if sit.cleared %}cleared{% else %}{{ sit.cut - sit.best }} short{% endif %}
                                    {% else %}no attempts yet{% endif %}
                                </div>
                            </div>
                        </div>

                        {% if sit.open_attempt %}
                        <div class="ex-callout">
                            <div class="ex-callout-label">Sitting in progress</div>
                            <p class="mb-3">You started this sitting and have not submitted it. The clock has been running since.</p>
                            <a class="ex-btn ex-btn-primary" href="{{ url_for('evaluation.take_evaluation', evaluation_id=sit.evaluation.id) }}">Resume the sitting</a>
                        </div>
                        {% endif %}

                        <div class="ex-section-head">
                            <span class="ex-label">What this sitting draws</span>
                            <span class="ex-label">Weight &middot; items</span>
                        </div>
                        <div class="ex-bp">
                            {% for row in sit.blueprint %}
                            <div class="ex-bp-row">
                                <div class="ex-bp-name">{{ row.name }}</div>
                                <div class="ex-bp-bar"><span style="width: {{ row.bar }}%"></span></div>
                                <div class="ex-bp-n">{{ row.weight }}% &middot; {{ row.draw }}</div>
                            </div>
                            {% endfor %}
                        </div>

                        <div class="ex-actions">
                            <a class="ex-btn ex-btn-primary ex-btn-lg" href="{{ url_for('evaluation.take_evaluation', evaluation_id=sit.evaluation.id) }}">
                                {% if sit.open_attempt %}Resume the sitting{% else %}Begin the sitting{% endif %}
                            </a>
                            <span class="ex-spec-note" style="margin: 0">Unlimited attempts. Every sitting draws a new paper.</span>
                        </div>
                        {% endif %}

                        <div class="ex-section-head">
                            <span class="ex-label">Or practice one domain at a time</span>
                            <span class="ex-label">Pool &middot; standing</span>
                        </div>
                        <p class="ex-lede" style="font-size: 15px; margin-top: 14px">
                            No clock, and the answer comes back the moment you choose it, with the reasoning.
                            Nothing here is recorded, so a domain you have since learned is not held down by an early guess.
                        </p>
                        <div class="ex-picklist">
                            {% for row in domains %}{% set pct = (row.correct * 100.0 / row.seen) if row.seen else 0 %}
                            <a class="ex-domain" href="{{ url_for('evaluation.practice', certification_key=selected_cert.key, domain_key=row.key) }}">
                                <span class="ex-domain-name">{{ row.name }}</span>
                                <span class="ex-domain-n">
                                    {{ row.questions | length }} item{{ '' if row.questions | length == 1 else 's' }}
                                    {% if row.seen %}&middot; {{ row.correct }}/{{ row.seen }} right{% endif %}
                                </span>
                            </a>
                            {% endfor %}
                        </div>

                        <p class="ex-disclosure">
                            <strong>What this is, exactly.</strong> Every item is original, written against
                            Anthropic&rsquo;s published exam guide for this certification; none is reproduced from a
                            real exam or from a commercial prep bank. Each sitting draws a new paper from the pool, so
                            two attempts are two different exams. A domain drill records nothing. A full sitting is
                            scored on a synthetic scale of our own, because the real conversion is proprietary and is
                            not modelled here, so treat the number as a study signal rather than a prediction of your
                            exam result.
                        </p>
                        {# The reuse grants for both contributed banks are conditional on credit. With
                           their items pooled rather than standing as separately named exams, this is
                           where that credit is visible; each item also carries its author in its own
                           source field. #}
                        <p class="ex-disclosure" style="margin-top: 14px; padding-top: 0; border-top: 0">
                            <strong>With thanks.</strong> This bank includes contributed work, used with
                            permission and credited at the authors&rsquo; request.
                            <a href="https://linkedin.com/in/purcellmatthew" rel="noopener">Matthew Purcell</a>,
                            who sat and passed the Associate exam, wrote the first full-length Associate practice
                            set when the official guide shipped only three sample questions.
                            Rick Hightower wrote the scenario-based Architect Foundations set. Option wording on
                            some of their items was revised by Intent Solutions to remove an answer-length cue;
                            no stem and no answer key was changed.
                        </p>

                        {% else %}
                        <div id="is-drill" data-count="{{ questions | length }}">
                            {% for question in questions %}
                            {% set correct_count = question.options | selectattr("is_correct", "equalto", true) | list | length %}
                            <section class="is-drill-item" data-index="{{ loop.index0 }}" {% if not loop.first %}hidden{% endif %}>
                                <div class="d-flex justify-content-between align-items-center mb-2 is-mono">
                                    <span style="color: var(--is-accent)">
                                        Question {{ loop.index }} of {{ questions | length }}
                                    </span>
                                    <span style="color: var(--is-muted)">
                                        {% if correct_count > 1 %}Select {{ correct_count }}{% else %}Select one{% endif %}
                                    </span>
                                </div>

                                <div class="is-card p-4 mb-3">
                                    <p class="is-stem mb-4">{{ question.text }}</p>

                                    {% for option in question.options %}
                                    <button type="button" class="is-choice" data-correct="{{ '1' if option.is_correct else '0' }}">
                                        <span class="is-key">{{ loop.index }}</span>
                                        <span>{{ option.text }}</span>
                                    </button>
                                    {% endfor %}

                                    <div class="is-feedback" hidden>
                                        {% if question.explanation %}{{ question.explanation }}{% else %}The highlighted
                                        option is the correct one.{% endif %}
                                    </div>

                                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3">
                                        <button type="button" class="btn btn-sm btn-outline-secondary is-reveal">
                                            Show the answer
                                        </button>
                                        <div class="d-flex gap-2">
                                            <button type="button" class="btn btn-sm btn-outline-secondary is-prev">
                                                &larr; Previous
                                            </button>
                                            <button type="button" class="btn btn-sm btn-dark is-next">Next &rarr;</button>
                                        </div>
                                    </div>
                                </div>
                            </section>
                            {% endfor %}
                        </div>

                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                            <p class="is-keys mb-0">
                                <kbd>1</kbd>&ndash;<kbd>9</kbd> answer &middot; <kbd>&larr;</kbd> <kbd>&rarr;</kbd> move
                            </p>
                            <a
                                class="btn btn-outline-dark"
                                href="{{ url_for('evaluation.practice', certification_key=selected_cert.key) }}"
                                >Pick another domain</a
                            >
                        </div>

                        <script>
                            (function () {
                                "use strict";
                                var root = document.getElementById("is-drill");
                                if (!root) return;
                                var items = Array.prototype.slice.call(root.querySelectorAll(".is-drill-item"));
                                if (!items.length) return;
                                var current = 0;

                                function reveal(item) {
                                    item.querySelectorAll(".is-choice").forEach(function (choice) {
                                        if (choice.dataset.correct === "1") choice.classList.add("is-right");
                                    });
                                    item.querySelector(".is-feedback").hidden = false;
                                }

                                function show(i) {
                                    if (i < 0 || i >= items.length) return;
                                    items[current].hidden = true;
                                    current = i;
                                    items[current].hidden = false;
                                    items[current].scrollIntoView({ block: "nearest" });
                                }

                                root.addEventListener("click", function (event) {
                                    var item = items[current];
                                    var choice = event.target.closest(".is-choice");
                                    if (choice) {
                                        choice.classList.add(choice.dataset.correct === "1" ? "is-right" : "is-wrong");
                                        choice.classList.add("is-picked");
                                        reveal(item);
                                        return;
                                    }
                                    if (event.target.closest(".is-reveal")) reveal(item);
                                    else if (event.target.closest(".is-next")) show(current + 1);
                                    else if (event.target.closest(".is-prev")) show(current - 1);
                                });

                                document.addEventListener("keydown", function (event) {
                                    if (event.metaKey || event.ctrlKey || event.altKey) return;
                                    // A focused control keeps its own Enter/Space.
                                    if (event.target && event.target.closest("button")) return;
                                    if (!items[current]) return;
                                    if (event.key === "ArrowRight") {
                                        event.preventDefault();
                                        show(current + 1);
                                    } else if (event.key === "ArrowLeft") {
                                        event.preventDefault();
                                        show(current - 1);
                                    } else if (/^[1-9]$/.test(event.key)) {
                                        var choices = items[current].querySelectorAll(".is-choice");
                                        var pick = choices[parseInt(event.key, 10) - 1];
                                        if (pick) {
                                            event.preventDefault();
                                            pick.click();
                                        }
                                    }
                                });
                            })();
                        </script>
                        {% endif %}
                    </div>
                </div>
            </div>
        </main>
    </body>
</html>
